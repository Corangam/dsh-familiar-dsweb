    "companion",
    "familiar"
  ],
  "author": {
    "name": "Corangam"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "./assets/icon.png",
  "homepage": "https://github.com/Corangam/dsh-familiar-dsweb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Corangam/dsh-familiar-dsweb.git"
  },
  "bugs": {
    "url": "https://github.com/Corangam/dsh-familiar-dsweb/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
