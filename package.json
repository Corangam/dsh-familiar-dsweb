{
  "name": "dsh-familiar-dsweb",
  "version": "1.0.1",
  "description": "Floating DeepSeek chat assistant for DSH Desktop: a draggable in-app webview panel that opens chat.deepseek.com as a side chat, so a quick question never pollutes your main coding session. 悬浮小助手。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "deepseek-chat",
    "webview",
    "floating-window",
    "floating-panel",
    "side-chat",
    "companion",
    "assistant",
    "chat-widget",
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Corangam"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "./assets/icon.png",
  "homepage": "https://github.com/Corangam/dsh-familiar-dsweb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Corangam/dsh-familiar-dsweb.git"
  },
  "bugs": {
    "url": "https://github.com/Corangam/dsh-familiar-dsweb/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "assets/",
    "docs/screenshot-*.jpg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "licenses/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
